# Copy to .env for local dev; set the same keys in the Vercel project settings.
# Both are optional — without them the /api form endpoints return a clear
# "not configured yet" response instead of sending.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Resend Audience the newsletter form subscribes people to —
# https://resend.com/audiences
RESEND_AUDIENCE_ID=

# The sender subdomain (send.conorfoy.com — see MAIL.from in src/lib/email.ts)
# must be verified in Resend for mail to send: https://resend.com/domains
# Add it as a new domain in Resend and copy its SPF / DKIM / DMARC records into
# conorfoy.com's DNS. A subdomain keeps these separate from the root domain's
# existing mail records.
