# Copy to .env for local dev; set the same keys in the Vercel project settings.
# Both are optional — without them the /api form endpoints return a clear
# "not configured yet" response instead of sending.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Resend Audience the newsletter form subscribes people to —
# https://resend.com/audiences
RESEND_AUDIENCE_ID=

# The sender domain (conorfoy.com) must be verified in Resend for mail to send:
# https://resend.com/domains
