---
import { PUBLIC_GA_ID } from 'astro:env/client';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';

const gaEnabled = Boolean(PUBLIC_GA_ID);
const updated = 'September 2026';
---
<BaseLayout
  title="Privacy — Conor Foy Plaster"
  description="What happens to the information you give us through this site."
>
  <Section border="none" pt={80} pb={80}>
    <div class="legal">
      <Eyebrow track={0.2} mb={24}>Privacy</Eyebrow>
      <h1 class="legal__title">What happens to your information.</h1>
      <p class="legal__updated text-muted tnum">Last updated: {updated}</p>

      <div class="legal__body">
        <p>
          This site is run by Conor Foy Plaster, a decorative plaster shop in
          New York. It has no accounts and no login. It collects what you type
          into one of the forms, plus traffic statistics{gaEnabled ? ' — anonymous by default, and more detailed only if you opt in' : ', which are anonymous'}.
          This page explains {gaEnabled ? 'all of it' : 'both'}.
        </p>

        <h2>What the forms collect</h2>
        <ul>
          <li>
            <strong>Consultation request</strong> (Contact page and Home page) —
            your name and email, and optionally your company, phone, role,
            project type, location, area, timeline, the finishes you are
            considering, and whatever you write in the message.
          </li>
          <li>
            <strong>JobsOxo waitlist</strong> — your name, company, email, crew
            size, and your message.
          </li>
          <li>
            <strong>Newsletter signup</strong> — your email address only.
          </li>
        </ul>
        <p>
          We ask for the optional fields because they help us give you a useful
          answer, not because we need them. Leave them blank if you prefer.
        </p>

        <h2>What we do with it</h2>
        <p>
          Consultation and waitlist submissions are emailed to us so we can
          reply — to <a href="mailto:info@conorfoy.com">info@conorfoy.com</a> for
          plaster enquiries, <a href="mailto:hello@jobsoxo.com">hello@jobsoxo.com</a>
          for JobsOxo. Newsletter addresses go onto our mailing list. That is
          the whole of it. We do not sell your information, share it for
          advertising, or use it to build a profile of you.
        </p>

        <h2>Who else handles it</h2>
        <ul>
          <li>
            <strong>Resend</strong> (resend.com) delivers the form emails and
            stores the newsletter mailing list on our behalf.
          </li>
          <li>
            <strong>Vercel</strong> (vercel.com) hosts the site and provides the
            always-on traffic statistics below.
          </li>
          {gaEnabled && (
            <li>
              <strong>Google</strong> (Google Analytics) — <em>only if you accept
              the analytics banner.</em> See below.
            </li>
          )}
        </ul>
        <p>
          {gaEnabled ? 'All' : 'Both'} are US companies acting as our processors.
          We use no other third-party service on this site — fonts are served
          from our own domain, and there are no ad networks or social widgets.
        </p>

        <h2>Analytics</h2>
        <p>
          <strong>Vercel Web Analytics</strong> runs for everyone. It is
          cookieless and aggregate — page views, referrers, rough location by
          country, device type — with no identifier that follows you between
          visits or across other sites. Nothing to consent to.
        </p>
        {gaEnabled ? (
          <p>
            <strong>Google Analytics 4</strong> runs <strong>only if you click
            &ldquo;Accept&rdquo;</strong> on the banner shown on your first visit.
            If you decline, or ignore it, no Google script loads and no Google
            cookies are set — your browser never contacts Google at all. If you
            accept, Google receives your page views, approximate location, device
            and referrer, tied to a cookie-based ID, and we see it in aggregate
            in the GA dashboard. Google Consent Mode is set so advertising
            signals stay off regardless.
          </p>
        ) : (
          <p>We do not use Google Analytics or any other third-party tracker.</p>
        )}

        <h2>Cookies</h2>
        {gaEnabled ? (
          <>
            <p>The site uses these, and no others:</p>
            <div class="legal__table-wrap">
              <table class="legal__table">
                <thead>
                  <tr><th>Name</th><th>Set by</th><th>Purpose</th><th>Lasts</th></tr>
                </thead>
                <tbody>
                  <tr>
                    <td>cfp-consent</td>
                    <td>this site</td>
                    <td>Remembers your analytics choice so the banner does not reappear. Stored in your browser only; never sent anywhere.</td>
                    <td>Until you clear it</td>
                  </tr>
                  <tr>
                    <td>_ga, _ga_&hellip;</td>
                    <td>Google Analytics</td>
                    <td>Distinguishes visitors and sessions. <strong>Set only after you accept.</strong></td>
                    <td>Up to 2 years</td>
                  </tr>
                </tbody>
              </table>
            </div>
            <p>
              You can change your mind any time:
              <button type="button" class="legal__reset" id="consent-reset">
                reopen the analytics choice
              </button>. To stop Google Analytics after accepting, decline there
              and clear your browser&rsquo;s cookies for this site.
            </p>
          </>
        ) : (
          <p>
            This site sets <strong>no cookies</strong> and stores nothing in your
            browser. There is nothing to consent to.
          </p>
        )}

        <h2>How long we keep it</h2>
        <p>
          We keep enquiry and waitlist correspondence for as long as we are
          working with you and for a reasonable period afterwards as a business
          record. Newsletter addresses stay on the list until you unsubscribe.
          Ask us to delete anything and we will, unless we are required to keep
          it.
        </p>

        <h2>Your choices</h2>
        <p>
          Every newsletter has an unsubscribe link.{gaEnabled ? ' You can accept or decline analytics on the banner, and change it later from the link above.' : ''} To
          see, correct, or delete anything else we hold about you, email
          <a href="mailto:info@conorfoy.com">info@conorfoy.com</a> and we will
          take care of it.
        </p>

        <h2>Changes</h2>
        <p>
          If this policy changes, the date at the top changes with it. Questions
          go to <a href="mailto:info@conorfoy.com">info@conorfoy.com</a>.
        </p>
      </div>
    </div>
  </Section>
</BaseLayout>

<script>
  // "reopen the analytics choice" — the button only exists when GA is configured.
  document.getElementById('consent-reset')?.addEventListener('click', () => {
    (window as typeof window & { __cfpConsentReset?: () => void }).__cfpConsentReset?.();
  });
</script>

<style>
  .legal {
    max-width: 66ch;
  }
  .legal__title {
    font-size: clamp(32px, 5.5vw, 56px);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
  }
  .legal__updated {
    font-size: 13px;
    margin: 0 0 40px;
  }

  .legal__body {
    font-size: 15px;
    line-height: 1.85;
  }
  .legal__body h2 {
    font-size: 21px;
    font-weight: 400;
    margin: 36px 0 10px;
  }
  .legal__body p {
    margin: 0 0 var(--space-3);
  }
  .legal__body ul {
    margin: 0 0 var(--space-3);
    padding-left: 1.2em;
  }
  .legal__body li {
    margin-bottom: 8px;
  }
  .legal__body a {
    color: var(--color-accent-700);
    text-underline-offset: 3px;
  }

  .legal__table-wrap {
    overflow-x: auto;
    margin: 0 0 var(--space-3);
  }
  .legal__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
    line-height: 1.6;
  }
  .legal__table th {
    text-align: left;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text) 60%, transparent);
    padding: 8px 16px 8px 0;
    border-bottom: 1px solid var(--color-divider);
    white-space: nowrap;
  }
  .legal__table td {
    padding: 10px 16px 10px 0;
    border-bottom: 1px solid var(--color-divider);
    vertical-align: top;
  }
  .legal__table td:first-child {
    font-family: var(--font-heading);
    white-space: nowrap;
  }
  .legal__table td:last-child {
    white-space: nowrap;
  }

  .legal__reset {
    font: inherit;
    color: var(--color-accent-700);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal__reset:hover {
    color: var(--color-accent-600);
  }
</style>
