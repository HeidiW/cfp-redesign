<script>
  // Double-click a filled strip photo to open it full size in a <dialog>.
  const dialog = document.getElementById('stripLightbox') as HTMLDialogElement | null;
  const dialogImg = dialog?.querySelector<HTMLImageElement>('.lightbox__img');

  if (dialog && dialogImg) {
    const open = (full: string, alt: string) => {
      dialogImg.src = full;
      dialogImg.alt = alt;
      dialog.showModal();
    };
    const close = () => {
      dialog.close();
      dialogImg.removeAttribute('src');
    };

    document.querySelectorAll<HTMLElement>('.strip8__cell--has-img').forEach((cell) => {
      cell.addEventListener('dblclick', () => {
        const full = cell.dataset.full;
        if (full) open(full, cell.dataset.alt ?? '');
      });
    });

    dialog.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('[data-lightbox-close]')) {
        close();
        return;
      }
      // Click outside the content box (on the backdrop) closes too.
      const box = dialog.getBoundingClientRect();
      const outside =
        event.clientX < box.left ||
        event.clientX > box.right ||
        event.clientY < box.top ||
        event.clientY > box.bottom;
      if (outside) close();
    });
    dialog.addEventListener('close', () => dialogImg.removeAttribute('src'));
  }
</script>
