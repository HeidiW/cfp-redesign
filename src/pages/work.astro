---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Eyebrow from '../components/Eyebrow.astro';
import WorkRow from '../components/WorkRow.astro';
import CtaBand from '../components/CtaBand.astro';
import { categories, jobs } from '../data/jobs';

---
<BaseLayout
  title="Work — Conor Foy Plaster"
  description="Twenty-three years of decorative plaster for restaurants, hotels and private residences across New York — the rooms, not the renderings."
>
  {/* ── Portfolio intro ─────────────────────────────────────────────── */}
  <Section border="none" pt={80} pb={48} class="work-hero">
    <div class="work-hero__row">
      <div>
        <Eyebrow track={0.2} mb={24}>Portfolio</Eyebrow>
        <h1 class="work-hero__title">Twenty-three years of interiors.</h1>
      </div>
      <p class="work-hero__lede">
        Restaurants, hotels and private residences across New York. Most of this
        work was drawn by an architect, bid by a general contractor and finished
        by our own crew — the names below are the rooms, not the renderings.
      </p>
    </div>

    <div class="work-hero__tags" id="work-filters">
      <button type="button" class="tag tag-accent" data-filter="All work" aria-pressed="true">All work</button>
      {categories.map((category) => (
        <button type="button" class="tag tag-outline" data-filter={category} aria-pressed="false">{category}</button>
      ))}
    </div>
  </Section>

  {/* ── Projects ────────────────────────────────────────────────────── */}
  <Section border="none" pt={24} pb={80} class="projects">
    {jobs.filter((job) => !job.hidden).map((job, i) => (
      <WorkRow
        index={i + 1}
        slug={job.slug}
        name={job.name}
        href={job.href}
        year={job.year}
        location={job.location}
        category={job.category}
        photos={job.photos}
      />
    ))}
    <p class="work-empty text-muted" id="work-empty" hidden>No projects in this category yet.</p>
  </Section>

  <CtaBand
    tone="surface"
    title="Drawing something now?"
    note="Send the room. We reply within one business day."
    ctaLabel="Request a consultation"
    ctaHref="/contact"
  />
</BaseLayout>

<style>
  /* ── Portfolio intro ─────────────────────────────────────────────── */
  .work-hero__row {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 64px;
    align-items: end;
  }
  .work-hero__title {
    font-size: clamp(38px, 7vw, 76px);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.025em;
    margin: 0;
  }
  .work-hero__lede {
    font-size: 16px;
    line-height: 1.85;
    text-align: justify;
    margin: 0 0 8px;
  }
  .work-hero__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 44px;
    padding-top: 28px;
    border-top: 1px solid var(--color-divider);
  }
  .work-hero__tags .tag {
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .work-hero__tags .tag:hover {
    border-color: var(--color-accent);
  }
  .work-hero__tags .tag:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* ── Projects ────────────────────────────────────────────────────── */
  .work-empty {
    font-size: 15px;
    padding: 40px 0;
  }

  /* ── Responsive ──────────────────────────────────────────────────── */
  @media (max-width: 1080px) {
    .work-hero__row {
      grid-template-columns: 1fr;
      gap: 22px;
    }
  }
</style>

<script>
  const filterBar = document.getElementById('work-filters');
  const buttons = Array.from(filterBar?.querySelectorAll<HTMLButtonElement>('[data-filter]') ?? []);
  const jobs = Array.from(document.querySelectorAll<HTMLElement>('.job'));
  const emptyMessage = document.getElementById('work-empty');

  function applyFilter(filter: string) {
    let visibleCount = 0;
    for (const job of jobs) {
      const match = filter === 'All work' || job.dataset.category === filter;
      job.hidden = !match;
      if (match) visibleCount += 1;
    }
    if (emptyMessage) emptyMessage.hidden = visibleCount > 0;

    for (const button of buttons) {
      const active = button.dataset.filter === filter;
      button.classList.toggle('tag-accent', active);
      button.classList.toggle('tag-outline', !active);
      button.setAttribute('aria-pressed', String(active));
    }
  }

  filterBar?.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
    if (!button) return;
    applyFilter(button.dataset.filter ?? 'All work');
  });
</script>
