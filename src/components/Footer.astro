---
import Brand from './Brand.astro';
import { footerLinks, isCurrent } from '../data/nav';

interface Props {
  /** Legal line. JobsOxo overrides it with the LLC credit. */
  legal?: string;
}
const { legal = '© 2026 Conor Foy Plaster' } = Astro.props;
const pathname = Astro.url.pathname;
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <Brand variant="compact" href="/" />

    <nav class="site-footer__nav" aria-label="Footer">
      {footerLinks.map((link) => (
        <a
          href={link.href}
          aria-current={isCurrent(link.href, pathname) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="site-footer__legal text-muted tnum">
      {legal} · <a class="site-footer__privacy" href="/privacy">Privacy</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-divider);
  }

  .site-footer__inner {
    max-width: 1280px;
    margin-inline: auto;
    padding: 48px clamp(20px, 5vw, 48px);
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    justify-content: space-between;
    align-items: center;
  }

  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    font-size: 13px;
  }

  .site-footer__nav a {
    text-decoration: none;
    color: inherit;
  }

  .site-footer__nav a:hover,
  .site-footer__nav a[aria-current='page'] {
    color: var(--color-accent);
  }

  .site-footer__legal {
    font-size: 12px;
  }

  .site-footer__privacy {
    color: inherit;
    text-decoration: none;
  }
  .site-footer__privacy:hover {
    color: var(--color-accent);
  }
</style>
