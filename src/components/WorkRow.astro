---
import Plate from './Plate.astro';
import type { ImageMetadata } from 'astro';

interface Photo {
  img: ImageMetadata;
  alt: string;
  room: string;
  materials: string;
}

interface Props {
  index: number;
  name: string;
  href?: string;
  year: string;
  location: string;
  category?: string;
  photos: Photo[];
}

const { index, name, href, year, location, category, photos } = Astro.props;
const num = String(index).padStart(2, '0');
---
<article class="job" data-category={category}>
  <div class="job__head">
    <div class="job__meta text-muted tnum">{num} — {year}</div>
    <h2 class="job__title">
      {href ? <a href={href} target="_blank" rel="noopener noreferrer" class="job__title-link">{name}</a> : name}
    </h2>
    <div class="job__place text-muted">{location}</div>
  </div>
  <div class="job__photos">
    {photos.map((photo) => (
      <figure class="job__photo">
        <Plate
          src={photo.img}
          alt={photo.alt}
          height={380}
          sizes="(max-width: 720px) calc(100vw - 40px), (max-width: 1080px) calc(50vw - 40px), 380px"
        />
        <figcaption class="job__cap">
          <div class="job__cap-room">{photo.room}</div>
          <p class="job__cap-materials text-muted">{photo.materials}</p>
        </figcaption>
      </figure>
    ))}
  </div>
</article>

<style>
  .job {
    padding-bottom: 64px;
    margin-bottom: 64px;
    border-bottom: 1px solid var(--color-divider);
  }
  .job:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .job__meta {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .job__title {
    font-size: 32px;
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 6px;
  }
  .job__title-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
  }
  .job__title-link:hover,
  .job__title-link:focus-visible {
    border-bottom-color: currentColor;
  }
  .job__place {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .job__photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 40px 32px;
  }
  .job__cap {
    margin-top: 14px;
  }
  .job__cap-room {
    font-size: 15px;
    margin-bottom: 4px;
  }
  .job__cap-materials {
    font-size: 13px;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 720px) {
    .job__photos {
      grid-template-columns: 1fr;
    }
  }
</style>
