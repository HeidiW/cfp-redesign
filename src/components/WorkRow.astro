---
import WorkPhotoGrid from './WorkPhotoGrid.astro';
import type { Photo } from '../data/jobs';

interface Props {
  index: number;
  slug: string;
  name: string;
  href?: string;
  year: string;
  location: string;
  category?: string;
  photos: Photo[];
}

const { index, slug, name, href, year, location, category, photos } = Astro.props;
const num = String(index).padStart(2, '0');
---
<article class="job" data-category={category}>
  <div class="job__head">
    <div class="job__meta text-muted tnum">{num} — {year}</div>
    <h2 class="job__title">
      <a href={`/work/${slug}/`} class="job__title-link">{name}</a>
    </h2>
    <div class="job__place text-muted">
      {location}
      {href && (
        <>
          {' · '}
          <a href={href} target="_blank" rel="noopener noreferrer" class="job__external-link">Visit site ↗</a>
        </>
      )}
    </div>
  </div>
  <WorkPhotoGrid photos={photos} />
</article>

<style>
  .job {
    padding-bottom: 64px;
    margin-bottom: 64px;
    border-bottom: 1px solid var(--color-divider);
  }
  .job:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }
  .job__meta {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .job__title {
    font-size: 32px;
    font-weight: 400;
    line-height: 1.1;
    margin: 0 0 6px;
  }
  .job__title-link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
  }
  .job__title-link:hover,
  .job__title-link:focus-visible {
    border-bottom-color: currentColor;
  }
  .job__place {
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 28px;
  }
  .job__external-link {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.15s ease;
  }
  .job__external-link:hover,
  .job__external-link:focus-visible {
    border-bottom-color: currentColor;
  }
</style>
