---
/** Full consultation-request form (Contact page). Posts to /api/contact,
 *  which emails info@conorfoy.com via Resend. Copy and fields are final
 *  (handoff); FormSwap handles the submit/label behaviour. */

const roles = ['Architect or designer', 'Contractor', 'Owner or operator', 'Trade partner'];
const finishes = [
  'Venetian',
  'Japanese plaster',
  'Tadelakt',
  'Gold leaf',
  'Murals',
  'Lime wash',
  'Restoration',
  'Not sure yet',
];
---
<form class="consult" method="post" action="/api/contact" data-swap-form>
  <div class="consult__pair">
    <div class="field">
      <label for="c-name">Name *</label>
      <input class="input" id="c-name" name="name" type="text" placeholder="Your name" required />
    </div>
    <div class="field">
      <label for="c-email">Email *</label>
      <input class="input" id="c-email" name="email" type="email" placeholder="you@studio.com" required />
    </div>
  </div>

  <div class="consult__pair">
    <div class="field">
      <label for="c-company">Company or studio</label>
      <input class="input" id="c-company" name="company" type="text" placeholder="Optional" />
    </div>
    <div class="field">
      <label for="c-phone">Phone</label>
      <input class="input" id="c-phone" name="phone" type="tel" placeholder="Optional" />
    </div>
  </div>

  <div class="field consult__choices">
    <label>You are a…</label>
    <div class="consult__radios">
      {roles.map((role) => (
        <label class="radio">
          <input type="radio" name="role" value={role} />
          <span class="dot"></span>
          {role}
        </label>
      ))}
    </div>
  </div>

  <div class="consult__pair">
    <div class="field">
      <label for="c-type">Project type *</label>
      <input class="input" id="c-type" name="projectType" type="text" placeholder="Restaurant, hotel, residence…" required />
    </div>
    <div class="field">
      <label for="c-location">Location</label>
      <input class="input" id="c-location" name="location" type="text" placeholder="Neighborhood is fine" />
    </div>
  </div>

  <div class="consult__pair">
    <div class="field">
      <label for="c-area">Approximate area</label>
      <input class="input" id="c-area" name="area" type="text" placeholder="e.g. 2,400 sq ft of wall" />
    </div>
    <div class="field">
      <label for="c-timeline">Timeline</label>
      <input class="input" id="c-timeline" name="timeline" type="text" placeholder="e.g. on site Q1 2027" />
    </div>
  </div>

  <div class="field consult__choices">
    <label>Finish you have in mind</label>
    <div class="consult__chips">
      {finishes.map((finish) => (
        <label class="chip">
          <input type="checkbox" name="finishes" value={finish} />
          <span>{finish}</span>
        </label>
      ))}
    </div>
  </div>

  <div class="field">
    <label for="c-message">Tell us about the room *</label>
    <textarea
      class="input consult__textarea"
      id="c-message"
      name="message"
      placeholder="What it is, what you want it to feel like, and anything already drawn or built."
      required></textarea>
  </div>

  <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <button
    class="btn btn-primary consult__submit"
    type="submit"
    data-swap-done="Thank you — we'll reply within a day"
  >
    Send request
  </button>
  <p class="form-status" data-form-status role="alert" hidden></p>
  <p class="consult__note text-muted">
    We reply to everything within one business day. Your details stay with us and
    are never passed on.
  </p>
</form>

<style>
  .consult {
    display: grid;
    gap: 20px;
  }

  .consult__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .consult__choices > label {
    display: block;
    font-size: 12px;
    margin-bottom: 5px;
    color: color-mix(in srgb, var(--color-text) 70%, transparent);
  }

  .consult__radios {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    padding-top: 4px;
  }

  .consult__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding-top: 4px;
  }

  /* Selectable finish chips — the design system's outline tag at rest, an
     accent tint when checked (tint, not fill, per the system). */
  .chip {
    display: inline-flex;
    cursor: pointer;
  }
  .chip input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .chip span {
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    letter-spacing: 0.02em;
    padding: 3px 10px;
    border-radius: calc(var(--radius-md) * 0.75);
    border: 1px solid var(--color-accent);
    color: var(--color-accent);
  }
  .chip:hover span {
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
  }
  .chip input:checked + span {
    background: var(--color-accent-100);
    color: var(--color-accent-800);
    box-shadow: inset 0 0 0 1px var(--color-accent);
  }
  .chip input:focus-visible + span {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .consult__textarea {
    min-height: 120px;
  }

  .consult__submit {
    justify-self: start;
    font-size: 14px;
    padding: 13px 26px;
  }

  .consult__note {
    font-size: 11.5px;
    line-height: 1.7;
    margin: 0;
  }

  /* data-rsp="rows" in the prototype: field pairs stack ≤1080px. */
  @media (max-width: 1080px) {
    .consult__pair {
      grid-template-columns: 1fr;
    }
  }
</style>
