---
/**
 * Logo — direction 01, the chosen typographic mark: a 34px square with a 1px
 * accent border and --radius-sm holding the initials, set beside the shop name
 * in the heading face. The "New York · Est. 2002" line shows only in `full`
 * form (header); the footer uses `compact`.
 */
interface Props {
  variant?: 'full' | 'compact';
  href?: string | null;
}
const { variant = 'full', href = '/' } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['brand', `brand--${variant}`]} {...href ? { href } : {}}>
  <span class="brand__mark" aria-hidden="true">CFP</span>
  <span class="brand__text">
    <span class="brand__name">Conor Foy Plaster</span>
    {variant === 'full' && (
      <span class="brand__meta text-muted">New York · Est. 2002</span>
    )}
  </span>
</Tag>

<style>
  .brand {
    display: flex;
    align-items: center;
    gap: 13px;
    text-decoration: none;
    color: inherit;
  }

  .brand__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    flex: none;
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: 14px;
    letter-spacing: 0.06em;
    color: var(--color-accent-700);
    padding-left: 0.06em;
  }

  .brand__text {
    display: grid;
    gap: 2px;
  }

  .brand__name {
    font-family: var(--font-heading);
    font-size: 17px;
    line-height: 1;
    letter-spacing: 0.01em;
  }

  .brand__meta {
    font-family: var(--font-body);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    line-height: 1;
    white-space: nowrap;
  }
</style>
