---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import ConsentAnalytics from '../components/ConsentAnalytics.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { NavLink } from '../data/nav';

interface Props {
  title: string;
  description?: string;
  /** Footer legal line override (JobsOxo). */
  footerLegal?: string;
  /** Header CTA override — JobsOxo swaps in "Join the waitlist" → #demo. */
  headerCta?: NavLink;
  /** Page ground. `neutral` is the lighter neutral-100 JobsOxo runs on. */
  pageTone?: 'default' | 'neutral';
}
const { title, description, footerLegal, headerCta, pageTone = 'default' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='1.5' y='1.5' width='29' height='29' rx='2' fill='%23ebf2fa' stroke='%23640d14' stroke-width='1.5'/%3E%3Ctext x='16' y='21.5' font-family='Georgia, serif' font-size='13' letter-spacing='0.5' fill='%23640d14' text-anchor='middle'%3ECF%3C/text%3E%3C/svg%3E"
    />
    <link rel="preload" href="/fonts/cormorant-garamond-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/lora-400-latin.woff2" as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body data-page-tone={pageTone === 'neutral' ? 'neutral' : undefined}>
    <Header cta={headerCta} />
    <main>
      <slot />
    </main>
    <Footer legal={footerLegal} />
    <Analytics />
    <ConsentAnalytics />
  </body>
</html>
